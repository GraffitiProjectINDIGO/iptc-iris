#------------------------------------------------------------------------------
# ExifTool config for iptc-iris: IPTC Photo Metadata 2026.1 Image Region fields
#
# ExifTool (checked with 13.58) defines Iptc4xmpExt:ImageRegion with the
# 2019.1 Region Boundary fields only. Without this config ExifTool silently
# drops rbShape values other than rectangle/circle/polygon, rbCoordinates and
# rbMbPartDetails, and refuses rMemberOf and ImageRegionDepthOrder.
#
# This file extends ExifTool's own ImageRegion structure in place, so every
# field ExifTool already defines keeps its original definition. It adds the
# Extended Image Region Boundaries fields and XMP-iptcExt:ImageRegionDepthOrder.
# Remove it once ExifTool supports IPTC 2026.1 natively.
#
# Usage: exiftool -config exiftool_iptc_2026.config ...
#------------------------------------------------------------------------------

require Image::ExifTool::XMP;
require 'Image/ExifTool/XMP2.pl';

my $region = $Image::ExifTool::XMP::iptcExt{ImageRegion}{Struct};
$region->{rMemberOf} = { Namespace => 'Iptc4xmpExt', FlatName => 'MemberOf' };

my $boundary = $region->{RegionBoundary}{Struct};
for my $shape (qw(point multipoint linestring multilinestring multipolygon)) {
    $boundary->{rbShape}{PrintConv}{$shape} = ucfirst($shape);
}
$boundary->{rbCoordinates} = { FlatName => 'Coordinates' };
$boundary->{rbMbPartDetails} = {
    FlatName => 'MbPartDetails',
    List     => 'Bag',
    Struct   => {
        STRUCT_NAME => 'MultiboundaryPartDetails',
        NAMESPACE   => 'Iptc4xmpExt',
        rbMbPdPartIndex       => { FlatName => 'PartIndex', Writable => 'integer' },
        rbMbPdPartId          => { FlatName => 'PartId' },
        rbMbPdPartName        => { FlatName => 'PartName' },
        rbMbPdPartDescription => { FlatName => 'PartDescription' },
    },
};

%Image::ExifTool::UserDefined = (
    'Image::ExifTool::XMP::iptcExt' => {
        ImageRegionDepthOrder => { Groups => { 2 => 'Image' }, List => 'Seq' },
    },
);

1;  # end
